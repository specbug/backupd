# Copy to .env and fill in.

# Cloudflare R2 (S3-compatible) credentials
# Create an R2 API token with Object Read & Write on the target bucket.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name

# How often to run the backup cycle, in seconds. Default: 86400 (24h).
BACKUP_INTERVAL_SECONDS=86400

# --- Google Drive: the secondary mirror ------------------------------------
# R2 stays the primary and takes every read and write. Drive exists only
# because R2 has no versioning. Leave GDRIVE_ENABLED unset and the container
# behaves exactly as it did before Drive existed: R2 only, nothing else changes.
GDRIVE_ENABLED=true

# Get the token by running this once on a machine with a browser:
#
#     rclone authorize "drive"
#
# It prints a one-line JSON blob. Paste it here verbatim, quoted. Leaving
# GDRIVE_CLIENT_ID/SECRET blank uses rclone's own published OAuth client, whose
# refresh tokens do not expire; a self-made client left in "Testing" publishing
# status expires them every 7 days.
GDRIVE_TOKEN='{"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}'

# The existing sixeleven.in folder. Open it in Drive and copy the last path
# segment of the URL: drive.google.com/drive/folders/<THIS_PART>
# Rooting the remote here is what makes a job's `destination` remote-agnostic,
# so the same key addresses both R2 and Drive and the layouts stay identical.
GDRIVE_ROOT_FOLDER_ID=your_sixeleven_in_folder_id

# Optional: your own Google OAuth client. Only worth setting if rclone's shared
# client starts getting throttled. See the note above about token expiry.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=

# Where overwritten and deleted objects go, as a sibling of the live mirror.
# Must not sit inside a job destination or rclone refuses the sync as
# overlapping. One dated bucket per cycle that had churn.
GDRIVE_VERSIONS_DIR=_versions

# How many dated buckets to keep. With a daily cycle this is a recovery
# *window*, not a per-file version count: 90 is roughly three months of
# "restore what it looked like before", and only churned bytes are stored.
GDRIVE_VERSIONS_KEEP=90

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- GENERATED by `hostd install` from framework/templates/agent.plist.
     Both agents run the same binary with a different subcommand, so there is
     one template here no matter how many apps are hosted. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>@@LABEL@@</string>

    <!-- Points at the installed copy in ~/.local/bin, never at the repo:
         macOS TCC blocks launchd from executing anything under ~/Documents. -->
    <key>ProgramArguments</key>
    <array>
        <string>@@HOME@@/.local/bin/hostd</string>
        <string>@@SUBCOMMAND@@</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- The agent is meant to exit after each pass; launchd must not respawn it. -->
    <key>KeepAlive</key>
    <false/>

    <!-- CRITICAL. `podman machine start` spawns vfkit (the VM) as our child,
         and `compose up --build` spawns the build. Without this key launchd
         reaps the whole process group the moment this short-lived script
         exits, killing the VM seconds after we brought it up. Any
         LaunchAgent-based podman setup without this is structurally broken. -->
    <key>AbandonProcessGroup</key>
    <true/>

    <!-- Overlapping passes are harmless: each subcommand takes a global lock
         and a second instance exits on sight of it. -->
    <key>StartInterval</key>
    <integer>@@INTERVAL@@</integer>

    <key>StandardOutPath</key>
    <string>@@HOME@@/Library/Logs/@@LABEL@@.log</string>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/Library/Logs/@@LABEL@@-error.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- git, podman and yq all live in /opt/homebrew/bin. launchd starts
             with a minimal PATH, so it has to be spelled out. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@@HOME@@</string>
    </dict>
</dict>
</plist>
